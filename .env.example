# Firebase Configuration (للمشروع في Firestore)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_PRIVATE_KEY_ID=key_id_here
FIREBASE_CLIENT_EMAIL=your_email@your_project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# Google Cloud Vision API (للـ OCR)
GOOGLE_CLOUD_CREDENTIALS_PATH=/path/to/credentials.json

# Flask Configuration
FLASK_ENV=production
FLASK_SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=False
PORT=5000

# Admin Password (لحماية لوحة الإدارة)
ADMIN_PASSWORD=your_admin_password_here
